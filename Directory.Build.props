<Project>

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Authors>Deinok,Alexander Rose,graphql-dotnet</Authors>
    <Description>A GraphQL Client for .NET</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NeutralLanguage>en-US</NeutralLanguage>
    <NoWarn>$(NoWarn);NU5105</NoWarn> <!--TODO: fix-->
    <NoWarn>$(NoWarn);1591</NoWarn> <!--TODO: write comments to public APIs-->
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) Feather.GraphQL contributors</Copyright>
    <RepositoryUrl>https://github.com/robotgryphon/Feather.GraphQL</RepositoryUrl>
    <!-- A package built without a version from CI is not one to publish by accident. -->
    <Version Condition="'$(Version)' == ''">0.0.1-local</Version>
    <IncludeSymbols>false</IncludeSymbols>
    <PackageProjectUrl>https://github.com/robotgryphon/Feather.GraphQL</PackageProjectUrl>
    <PackageTags>GraphQL</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Deterministic>true</Deterministic>
    <!-- https://help.github.com/en/actions/configuring-and-managing-workflows/using-environment-variables -->
    <!-- https://github.com/clairernovotny/DeterministicBuilds -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
    <ImplicitUsings>enable</ImplicitUsings>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <IsPackable>true</IsPackable>
    <!-- In-repo projects reference the library by project, so the packed build props that would
         normally turn this on does not reach them. Consumers get it from the package. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Feather.GraphQL.Linq.Generated</InterceptorsNamespaces>
    <!-- The property was named InterceptorsPreviewNamespaces before .NET 9, and a tool built
         against the older compiler looks for that one instead. Setting both means the same
         opt-in is found whichever Roslyn reads it — an IDE running its own is the usual case. -->
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Feather.GraphQL.Linq.Generated</InterceptorsPreviewNamespaces>
  </PropertyGroup>

</Project>
