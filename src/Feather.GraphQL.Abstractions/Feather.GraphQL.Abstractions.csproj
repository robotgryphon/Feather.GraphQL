<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Turns on the trim and AOT analyzers, so anything a NativeAOT build cannot
         see is a warning here rather than a failure in a consumer's publish. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup>
    <Description>The contract between a GraphQL query and the code that runs it: the variables a query binds, the attributes that declare one, and the exception every transport fails with</Description>
    <RootNamespace>Feather.GraphQL</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- [PublicAPI] and [UsedImplicitly] are hints for an IDE and nothing else reads them,
         so the reference is compile-time only: PrivateAssets keeps the assembly out of
         every consumer's dependency graph and out of what they publish. -->
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
  </ItemGroup>
</Project>
