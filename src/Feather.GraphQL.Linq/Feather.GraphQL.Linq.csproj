<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Turns on the trim and AOT analyzers, so anything a NativeAOT build cannot
         see is a warning here rather than a failure in a consumer's publish. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup>
    <Description>LINQ / IQueryable translation to GraphQL for Feather.GraphQL</Description>
    <RootNamespace>Feather.GraphQL.Linq</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
  </ItemGroup>
  <ItemGroup>
    <!-- The transport that ships beside this one reads replies with the internal reply reader.
         A transport written elsewhere implements the seam and reads replies its own way; keeping
         the reader internal is what stops it and its failure signal from being public API. -->
    <InternalsVisibleTo Include="Feather.GraphQL.Linq.Providers.HttpClient" />
    <InternalsVisibleTo Include="Feather.GraphQL.Benchmarks" />
    <!-- The tests reach the internal chain parser and query provider directly. -->
    <InternalsVisibleTo Include="Feather.GraphQL.Linq.Tests" />
    <InternalsVisibleTo Include="Feather.GraphQL.Linq.Analyzers.Tests" />
    <InternalsVisibleTo Include="Feather.GraphQL.Linq.Providers.HttpClient.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- For the contract registry, which sits below both halves of the library: a reply is read
         through the same contracts whether its query was composed or written out by hand. This
         assembly still raises no transport error of its own — that stays with the transport,
         which owns the exception carrying the response. -->
    <ProjectReference Include="..\Feather.GraphQL.Abstractions\Feather.GraphQL.Abstractions.csproj" />
    <ProjectReference Include="..\Feather.GraphQL.Serialization\Feather.GraphQL.Serialization.csproj" />
    <!-- Because the analyzer this package carries emits calls into it. A compiled query posts with
         PostGraphQLBodyAsync and reads with ReadGraphQLReplyAsync, so a consumer who installs this
         package and writes one would otherwise get generated code that does not compile. Nothing
         in this assembly calls Http; the dependency is the generated half's, and it has to be
         declared by whoever ships the generator. -->
    <ProjectReference Include="..\Feather.GraphQL.Http\Feather.GraphQL.Http.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The analyzer ships inside this package, so a consumer gets the compile-time half of the
         rule table by referencing the library. ReferenceOutputAssembly is false because the
         library does not call into it; the reference exists to order the build. -->
    <ProjectReference Include="..\Feather.GraphQL.Linq.Analyzers\Feather.GraphQL.Linq.Analyzers.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all"
                      UndefineProperties="PublishAot;RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Feather.GraphQL.Linq.Analyzers\bin\$(Configuration)\netstandard2.0\Feather.GraphQL.Linq.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Attributes\" />
  </ItemGroup>
</Project>
