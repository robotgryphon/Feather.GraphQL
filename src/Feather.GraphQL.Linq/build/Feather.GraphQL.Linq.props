<Project>

  <PropertyGroup>
    <!--
      Interceptors are opt-in per namespace, and a package that ships them has to add its own:
      without this the compiler reports every generated interceptor as an error. Appending rather
      than assigning leaves any namespace the project already allowed intact.
    -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Feather.GraphQL.Linq.Generated</InterceptorsNamespaces>
    <!-- The property was named InterceptorsPreviewNamespaces before .NET 9, and a tool built
         against the older compiler looks for that one instead. Setting both means the same
         opt-in is found whichever Roslyn reads it — an IDE running its own is the usual case. -->
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Feather.GraphQL.Linq.Generated</InterceptorsPreviewNamespaces>
  </PropertyGroup>

</Project>
