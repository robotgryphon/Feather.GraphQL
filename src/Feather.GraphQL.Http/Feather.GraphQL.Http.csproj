<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Turns on the trim and AOT analyzers, so anything a NativeAOT build cannot
         see is a warning here rather than a failure in a consumer's publish. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace>Feather.GraphQL.Http</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- [PublicAPI] and [UsedImplicitly] are hints for an IDE and nothing else reads them,
         so the reference is compile-time only: PrivateAssets keeps the assembly out of
         every consumer's dependency graph and out of what they publish. -->
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Feather.GraphQL.Abstractions\Feather.GraphQL.Abstractions.csproj" />
    <ProjectReference Include="..\Feather.GraphQL.Serialization\Feather.GraphQL.Serialization.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- GraphQLRequest is the internal wire shape; the HttpClient transport package builds one,
         and the test projects assert on its serialization. Feather.GraphQL.Linq is deliberately
         absent: it does not reference this assembly at all. -->
    <InternalsVisibleTo Include="Feather.GraphQL.Linq.Providers.HttpClient" />
    <InternalsVisibleTo Include="Feather.GraphQL.Tests" />
  </ItemGroup>
</Project>