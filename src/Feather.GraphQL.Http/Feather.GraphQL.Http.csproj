<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Feather.GraphQL.Http</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="All" />
    <PackageReference Update="GitVersion.MsBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Feather.GraphQL.Abstractions\Feather.GraphQL.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- GraphQLRequest is the internal wire shape; the HttpClient transport package builds one,
         and the test projects assert on its serialization. Feather.GraphQL.Linq is deliberately
         absent: it does not reference this assembly at all. -->
    <InternalsVisibleTo Include="Feather.GraphQL.Linq.Providers.HttpClient" />
    <InternalsVisibleTo Include="Feather.GraphQL.Tests" />
  </ItemGroup>
</Project>