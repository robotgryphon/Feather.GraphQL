<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;RuntimeIdentifier;SelfContained">
  <PropertyGroup>
    <!-- An analyzer runs in the compiler, never in a published app. A consumer publishing
         with NativeAOT passes these to every project in its graph, and this one cannot
         honour them. -->
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Analyzers load into the compiler, which runs on .NET Standard 2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <TargetFrameworks />
    <Description>Compile-time diagnostics for the Feather.GraphQL LINQ provider</Description>
    <RootNamespace>Feather.GraphQL.Linq.Analyzers</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Feather.GraphQL.Linq.Analyzers.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Linked, not referenced: an analyzer carries its dependencies into the compiler, and one
         copy of a rule cannot drift from itself. -->
  </ItemGroup>
  <ItemGroup>
    <!-- Release tracking: the rule table, in the form the Roslyn analyzers check. -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Update="GitVersion.MsBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
