<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Turns on the trim and AOT analyzers, so anything a NativeAOT build cannot
         see is a warning here rather than a failure in a consumer's publish. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup>
    <Description>HttpClient transport for the Feather.GraphQL LINQ provider</Description>
    <!-- Namespace deliberately stops short of the package name: a namespace ending in
         `HttpClient` would shadow the type of the same name in every file that used it. -->
    <RootNamespace>Feather.GraphQL.Linq.Providers</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <!-- For the IOptions<T> overloads only; the delegate and instance forms need nothing. -->
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Feather.GraphQL.Linq.Providers.HttpClient.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- PrivateAssets="none" so the analyzer flows. NuGet marks analyzers private by default,
         which means a package that depends on one carrying an analyzer does not pass it on — a
         consumer installing this package would get the LINQ surface with none of the diagnostics
         and no generator, and their chains would compile and then throw. -->
    <ProjectReference Include="..\Feather.GraphQL.Linq\Feather.GraphQL.Linq.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Feather.GraphQL.Http\Feather.GraphQL.Http.csproj" />
  </ItemGroup>
</Project>
