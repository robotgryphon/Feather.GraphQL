<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Cleared so the packages under test can only come from the folder dotnet pack wrote to,
         and never from a published version of the same id that happens to be cached. -->
    <clear />
    <add key="local" value="../../nupkg" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
